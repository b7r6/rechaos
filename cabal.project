-- Reproducible non-nix cabal builds. The single cabal package (rechaos.cabal)
-- carries the proto internal library, the main library, the executable, and the
-- core test-suite; `packages: .` pulls all four in and `tests: True` builds the
-- test-suite by default so `cabal build all` / `cabal test core` work with no
-- extra flags in a compatible cabal-install package plan.
packages: .
tests: True

-- Pin the Hackage index to a fixed timestamp so a plain `cabal build` resolves
-- the same plan over time. Bump this date deliberately when you want newer deps.
index-state: 2026-09-01T00:00:00Z

-- The nix flake is the authoritative build. cabal resolves its own plan from
-- the Hackage index above and may differ from the nix pin — in particular the
-- random 1.2/1.3 split that the flake tolerates via allowInconsistentDependencies
-- (see flake.nix). The dev-shell wrappers use Setup.hs against the installed
-- Nix packages to avoid asking cabal-install to solve that incompatible split.
