// Single-process NativeLink cluster WITH an executing worker, for an airtight
// reproduction of the scheduler queue-GC leak on the COMPLETED-action path.
// Memory scheduler (default backend), aggressive retention so a completed action
// *should* be reclaimed within seconds. Adapted from
// nativelink-config/examples/local_rbe_self_test.json5. No external services.
{
  stores: [
    { name: "CAS_MAIN_STORE", filesystem: {
        content_path: "/tmp/rechaos/schedsrv2/content-cas",
        temp_path: "/tmp/rechaos/schedsrv2/tmp-cas",
        eviction_policy: { max_bytes: 2000000000 } } },
    { name: "AC_MAIN_STORE", filesystem: {
        content_path: "/tmp/rechaos/schedsrv2/content-ac",
        temp_path: "/tmp/rechaos/schedsrv2/tmp-ac",
        eviction_policy: { max_bytes: 200000000 } } },
    { name: "WORKER_FAST_SLOW_STORE", fast_slow: {
        fast: { filesystem: {
            content_path: "/tmp/rechaos/schedsrv2/content-worker",
            temp_path: "/tmp/rechaos/schedsrv2/tmp-worker",
            eviction_policy: { max_bytes: 2000000000 } } },
        slow: { ref_store: { name: "CAS_MAIN_STORE" } } } },
  ],
  schedulers: [
    { name: "MAIN_SCHEDULER", simple: {
        supported_platform_properties: {
          cpu_count: "minimum", OSFamily: "priority", "container-image": "priority",
        },
        // Aggressive: a completed action should be reclaimed ~5s after completion.
        retain_completed_for_s: 5,
        client_action_timeout_s: 11,
        worker_timeout_s: 30,
        max_action_executing_timeout_s: 30,
        max_job_retries: 0,
    } },
  ],
  workers: [
    { local: {
        worker_api_endpoint: { uri: "grpc://127.0.0.1:50062" },
        cas_fast_slow_store: "WORKER_FAST_SLOW_STORE",
        upload_action_result: { ac_store: "AC_MAIN_STORE" },
        work_directory: "/tmp/rechaos/schedsrv2/work",
        platform_properties: {
          cpu_count: { values: ["1"] },
          OSFamily: { values: [""] },
          "container-image": { values: [""] },
        },
    } },
  ],
  servers: [
    { name: "local", listener: { http: { socket_address: "127.0.0.1:50090" } },
      services: {
        cas: [ { cas_store: "CAS_MAIN_STORE" } ],
        ac: [ { ac_store: "AC_MAIN_STORE" } ],
        bytestream: [ { cas_store: "CAS_MAIN_STORE" } ],
        execution: [ { cas_store: "CAS_MAIN_STORE", scheduler: "MAIN_SCHEDULER" } ],
        capabilities: [ { remote_execution: { scheduler: "MAIN_SCHEDULER" } } ],
        experimental_prometheus: { path: "/metrics" },
      } },
    { name: "worker_api", listener: { http: { socket_address: "127.0.0.1:50062" } },
      services: { worker_api: { scheduler: "MAIN_SCHEDULER" }, health: {} } },
  ],
  global: { max_open_files: 24576 },
}
